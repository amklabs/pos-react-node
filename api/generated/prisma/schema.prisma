// schema.prisma
// After schema update :  npx prisma db push, npx prisma generate
// After updating by team : npx prisma db pull
generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql" // Using Neon or Supabase
}

model Town {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  customers Customer[]
  invoices  Invoice[]
}

model Company {
  id       Int       @id @default(autoincrement())
  name     String
  phone    String
  products Product[]
}

model Product {
  id           Int           @id @default(autoincrement())
  name         String
  companyId    Int
  company      Company       @relation(fields: [companyId], references: [id])
  invoiceItems InvoiceItem[]
}

model Customer {
  id          Int          @id @default(autoincrement())
  name        String
  phone       String
  townId      Int
  town        Town         @relation(fields: [townId], references: [id])
  invoices    Invoice[]
  cashRecords CashRecord[]
}

model Salesman {
  id       Int       @id @default(autoincrement())
  name     String
  phone    String
  invoices Invoice[]
}

model Invoice {
  id          Int           @id @default(autoincrement())
  invoiceNo   String        @unique
  date        DateTime      @default(now())
  type        String // "SALE" or "PURCHASE"
  townId      Int
  town        Town          @relation(fields: [townId], references: [id])
  customerId  Int?
  customer    Customer?     @relation(fields: [customerId], references: [id])
  salesmanId  Int?
  salesman    Salesman?     @relation(fields: [salesmanId], references: [id])
  items       InvoiceItem[]
  totalAmount Float         @default(0)
  createdAt   DateTime?     @default(now())
  updatedAt   DateTime?     @updatedAt
}

model InvoiceItem {
  id        Int     @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  qty       Int
  rate      Float
  discount  Float   @default(0)
}

model CashRecord {
  id         Int       @id @default(autoincrement())
  date       DateTime  @default(now())
  type       String // "RECEIVED" or "PAID"
  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id])
  amount     Float
  note       String?
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  firstname String?
  lastname  String?
  roleId    Int?
  role      Role?    @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
